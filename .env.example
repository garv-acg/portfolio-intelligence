# Email delivery (required for automated sending)
RESEND_API_KEY=

# News aggregation (recommended)
NEWSAPI_KEY=

# Improved summarization (optional)
OPENAI_API_KEY=

# FRED macroeconomic data (optional)
FRED_API_KEY=

# Control Center (optional) — Postgres connection for shared portfolio/
# transactions state + the execution ledger. Unset = pure local CSV, no
# behavior change. See CONTROL_CENTER.md.
DATABASE_URL=

# Control Center API (optional) — shared-secret header the web Control
# Center's Render backend checks. Only read by server/, not the local
# pipeline. Unset = no auth enforced.
API_KEY=
