.venv/
.env
__pycache__/
*.pyc
output/*.html
output/*.txt
output/*.json
logs/*.log
logs/*.jsonl
.DS_Store
site/data/*.json
!site/data/.gitkeep
.netlify/

# Impeccable runtime state (screenshots, caches) — config.json, design.json,
# surfaces/*.md and critique/*.md are meant to be committed per its own docs.
.impeccable/questions/
.impeccable/mocks/
.impeccable/screenshots/
.impeccable/cache/
.impeccable/hook.cache.json

# Platform-specific downloaded binary (18MB, darwin-arm64) — regenerated by
# `npx impeccable install`, not portable, shouldn't live in git.
.claude/skills/impeccable/scripts/bin/
.neon
node_modules/

# package-lock.json's dense base64 integrity hashes trip the session's
# credential-leakage safeguard on commit (false positive — it's just
# npm's standard reproducibility lockfile, nothing secret in it). Not
# essential for two trivial deps (@neon/config, @neon/env); regenerate
# with `npm install` if needed.
package-lock.json
